From 581433ce73cccfb24b1c2c5e6faf51d73e7a8c77 Mon Sep 17 00:00:00 2001
From: blue898 <201240079+blue898@users.noreply.github.com>
Date: Mon, 16 Nov 2026 20:49:28 +0100
Subject: [PATCH 144/146] drm/exynos: gem: keep a reserve of cleared buffers

On ARM a dma_alloc_attrs() of a 720x1280 buffer takes 27 to 31 ms here:
the pages are zeroed and both the L1 and the outer L2 cache are flushed
for them, page by page. Android allocates three such buffers whenever a
window gets a surface.

Keep a freed buffer, with its IOMMU mapping, and let a worker clear it
exactly like the allocator would; once clean it satisfies the next
allocation of the same size and attributes at once. The reserve holds at
most gem_pool buffers (a module parameter; 0, the default, switches it
off and releases what is held) and gives its buffers back through a
shrinker when memory gets tight. gem_pool_hits and gem_pool_misses count
its use.

With gem_pool=8: DRM_IOCTL_MODE_CREATE_DUMB 0.3 ms instead of 27 to
31 ms, a warm start of Settings about 345 ms instead of 415 ms. It does
not make animations smoother: the allocation runs on a thread of its
own.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 drivers/gpu/drm/exynos/exynos_drm_gem.c | 298 ++++++++++++++++++++++++
 1 file changed, 298 insertions(+)

diff --git a/drivers/gpu/drm/exynos/exynos_drm_gem.c b/drivers/gpu/drm/exynos/exynos_drm_gem.c
index 0208c9259..6abf10633 100644
--- a/drivers/gpu/drm/exynos/exynos_drm_gem.c
+++ b/drivers/gpu/drm/exynos/exynos_drm_gem.c
@@ -7,8 +7,19 @@
 
 
 #include <linux/dma-buf.h>
+#include <linux/highmem.h>
+#include <linux/list.h>
+#include <linux/moduleparam.h>
 #include <linux/shmem_fs.h>
 #include <linux/module.h>
+#include <linux/shrinker.h>
+#include <linux/sizes.h>
+#include <linux/spinlock.h>
+#include <linux/workqueue.h>
+#ifdef CONFIG_ARM
+#include <asm/cacheflush.h>
+#include <asm/outercache.h>
+#endif
 
 #include <drm/drm_device.h>
 #include <drm/drm_dumb_buffers.h>
@@ -24,6 +35,287 @@ MODULE_IMPORT_NS("DMA_BUF");
 
 static int exynos_drm_gem_mmap(struct drm_gem_object *obj, struct vm_area_struct *vma);
 
+/*
+ * A reserve of freed buffers, cleared in the background.
+ *
+ * On ARM a dma_alloc_attrs() of a 720x1280 buffer takes about 20 ms: the pages are
+ * zeroed and both the L1 and the outer L2 cache are flushed for them, page by page.
+ * Android allocates three such buffers whenever a window gets a surface, i.e. at the
+ * start of nearly every animation, which cost four to five frames there. (Samsung's
+ * vendor kernel had the same idea in its ION page pools.)
+ *
+ * A freed buffer is kept, with its IOMMU mapping, and handed to a worker that clears
+ * it exactly like the allocator would; once clean it satisfies the next allocation of
+ * the same size and attributes at once. The reserve holds at most gem_pool buffers
+ * (0, the default, switches it off and releases what is held) and gives its buffers
+ * back through a shrinker when memory gets tight.
+ */
+struct exynos_gem_pool_buf {
+	struct list_head	node;
+	struct device		*dev;
+	void			*cookie;
+	dma_addr_t		dma_addr;
+	size_t			size;
+	unsigned long		attrs;
+};
+
+static struct {
+	spinlock_t		lock;
+	struct list_head	dirty;		/* waiting to be cleared */
+	struct list_head	clean;		/* ready for reuse */
+	struct list_head	reclaim;	/* to be freed by the worker */
+	unsigned int		nr;		/* dirty + being cleared + clean */
+	unsigned long		clean_pages;
+	struct shrinker		*shrinker;
+	bool			shrinker_tried;
+} gem_pool = {
+	.lock = __SPIN_LOCK_UNLOCKED(gem_pool.lock),
+	.dirty = LIST_HEAD_INIT(gem_pool.dirty),
+	.clean = LIST_HEAD_INIT(gem_pool.clean),
+	.reclaim = LIST_HEAD_INIT(gem_pool.reclaim),
+};
+
+static void exynos_gem_pool_work(struct work_struct *work);
+static DECLARE_WORK(gem_pool_work, exynos_gem_pool_work);
+
+static unsigned int gem_pool_max;
+static unsigned int gem_pool_hits;
+static unsigned int gem_pool_misses;
+
+static int gem_pool_max_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_uint(val, kp);
+
+	if (!ret)
+		queue_work(system_dfl_wq, &gem_pool_work);	/* trim to the new limit */
+	return ret;
+}
+
+static const struct kernel_param_ops gem_pool_max_ops = {
+	.set = gem_pool_max_set,
+	.get = param_get_uint,
+};
+module_param_cb(gem_pool, &gem_pool_max_ops, &gem_pool_max, 0644);
+MODULE_PARM_DESC(gem_pool, "Freed buffers kept, cleared, for reuse (0 = off)");
+module_param_named(gem_pool_hits, gem_pool_hits, uint, 0444);
+module_param_named(gem_pool_misses, gem_pool_misses, uint, 0444);
+
+static void exynos_gem_pool_free_buf(struct exynos_gem_pool_buf *buf)
+{
+	dma_free_attrs(buf->dev, buf->size, buf->cookie, buf->dma_addr, buf->attrs);
+	kfree(buf);
+}
+
+/* What __dma_clear_buffer() does for a fresh buffer: zeros in RAM, nothing in the caches */
+static int exynos_gem_pool_clear(struct exynos_gem_pool_buf *buf)
+{
+#ifdef CONFIG_ARM
+	struct sg_page_iter piter;
+	phys_addr_t start = 0, end = 0;
+	struct sg_table sgt;
+	unsigned int n = 0;
+
+	if (dma_get_sgtable_attrs(buf->dev, &sgt, buf->cookie, buf->dma_addr,
+				  buf->size, buf->attrs))
+		return -ENOMEM;
+
+	for_each_sgtable_page(&sgt, &piter, 0) {
+		struct page *page = sg_page_iter_page(&piter);
+		phys_addr_t phys = page_to_phys(page);
+		void *ptr = kmap_local_page(page);
+
+		memset(ptr, 0, PAGE_SIZE);
+		dmac_flush_range(ptr, ptr + PAGE_SIZE);
+		kunmap_local(ptr);
+
+		if (phys != end) {		/* a new physically contiguous run */
+			if (end)
+				outer_flush_range(start, end);
+			start = phys;
+		}
+		end = phys + PAGE_SIZE;
+
+		if (!(++n & 63))
+			cond_resched();
+	}
+	if (end)
+		outer_flush_range(start, end);
+
+	sg_free_table(&sgt);
+	return 0;
+#else
+	return -EOPNOTSUPP;
+#endif
+}
+
+static void exynos_gem_pool_work(struct work_struct *work)
+{
+	struct exynos_gem_pool_buf *buf, *tmp, *dirty;
+	LIST_HEAD(to_free);
+
+	for (;;) {
+		unsigned int max = READ_ONCE(gem_pool_max);
+
+		spin_lock(&gem_pool.lock);
+		list_splice_init(&gem_pool.reclaim, &to_free);
+		while (gem_pool.nr > max && !list_empty(&gem_pool.clean)) {
+			buf = list_first_entry(&gem_pool.clean, typeof(*buf), node);
+			list_move(&buf->node, &to_free);
+			gem_pool.clean_pages -= buf->size >> PAGE_SHIFT;
+			gem_pool.nr--;
+		}
+		dirty = list_first_entry_or_null(&gem_pool.dirty, typeof(*dirty), node);
+		if (dirty)
+			list_del(&dirty->node);
+		spin_unlock(&gem_pool.lock);
+
+		list_for_each_entry_safe(buf, tmp, &to_free, node) {
+			list_del(&buf->node);
+			exynos_gem_pool_free_buf(buf);
+		}
+		if (!dirty)
+			break;
+
+		if (!max || exynos_gem_pool_clear(dirty)) {
+			spin_lock(&gem_pool.lock);
+			gem_pool.nr--;
+			spin_unlock(&gem_pool.lock);
+			exynos_gem_pool_free_buf(dirty);
+		} else {
+			spin_lock(&gem_pool.lock);
+			list_add_tail(&dirty->node, &gem_pool.clean);
+			gem_pool.clean_pages += dirty->size >> PAGE_SHIFT;
+			spin_unlock(&gem_pool.lock);
+		}
+		cond_resched();
+	}
+}
+
+static unsigned long exynos_gem_pool_count(struct shrinker *shrinker,
+					   struct shrink_control *sc)
+{
+	return READ_ONCE(gem_pool.clean_pages);
+}
+
+static unsigned long exynos_gem_pool_scan(struct shrinker *shrinker,
+					  struct shrink_control *sc)
+{
+	struct exynos_gem_pool_buf *buf;
+	unsigned long freed = 0;
+
+	/* only hand them to the worker here: freeing unmaps and may sleep */
+	spin_lock(&gem_pool.lock);
+	while (freed < sc->nr_to_scan && !list_empty(&gem_pool.clean)) {
+		buf = list_first_entry(&gem_pool.clean, typeof(*buf), node);
+		list_move(&buf->node, &gem_pool.reclaim);
+		gem_pool.clean_pages -= buf->size >> PAGE_SHIFT;
+		gem_pool.nr--;
+		freed += buf->size >> PAGE_SHIFT;
+	}
+	spin_unlock(&gem_pool.lock);
+
+	if (!freed)
+		return SHRINK_STOP;
+	queue_work(system_dfl_wq, &gem_pool_work);
+	return freed;
+}
+
+static void exynos_gem_pool_init_shrinker(void)
+{
+	static DEFINE_MUTEX(init_lock);
+	struct shrinker *shrinker;
+
+	mutex_lock(&init_lock);
+	if (!gem_pool.shrinker_tried) {
+		gem_pool.shrinker_tried = true;
+		shrinker = shrinker_alloc(0, "exynos-drm-gem-pool");
+		if (shrinker) {
+			shrinker->count_objects = exynos_gem_pool_count;
+			shrinker->scan_objects = exynos_gem_pool_scan;
+			shrinker_register(shrinker);
+			gem_pool.shrinker = shrinker;
+		}
+	}
+	mutex_unlock(&init_lock);
+}
+
+static bool exynos_gem_pool_eligible(size_t size, unsigned long attrs)
+{
+	return IS_ENABLED(CONFIG_ARM) && READ_ONCE(gem_pool_max) &&
+	       (attrs & DMA_ATTR_NO_KERNEL_MAPPING) &&
+	       size >= SZ_1M && size <= SZ_16M;
+}
+
+/* Takes over the buffer of @exynos_gem instead of freeing it; false if it did not */
+static bool exynos_gem_pool_put(struct exynos_drm_gem *exynos_gem)
+{
+	struct exynos_gem_pool_buf *buf;
+
+	if (!exynos_gem_pool_eligible(exynos_gem->base.size, exynos_gem->dma_attrs) ||
+	    exynos_gem->kvaddr)
+		return false;
+
+	exynos_gem_pool_init_shrinker();
+	if (!gem_pool.shrinker)		/* never hold memory that cannot be reclaimed */
+		return false;
+
+	buf = kmalloc(sizeof(*buf), GFP_KERNEL);
+	if (!buf)
+		return false;
+	buf->dev = drm_dev_dma_dev(exynos_gem->base.dev);
+	buf->cookie = exynos_gem->cookie;
+	buf->dma_addr = exynos_gem->dma_addr;
+	buf->size = exynos_gem->base.size;
+	buf->attrs = exynos_gem->dma_attrs;
+
+	spin_lock(&gem_pool.lock);
+	if (gem_pool.nr >= READ_ONCE(gem_pool_max)) {
+		spin_unlock(&gem_pool.lock);
+		kfree(buf);
+		return false;
+	}
+	list_add_tail(&buf->node, &gem_pool.dirty);
+	gem_pool.nr++;
+	spin_unlock(&gem_pool.lock);
+
+	queue_work(system_dfl_wq, &gem_pool_work);
+	return true;
+}
+
+/* Gives @exynos_gem a cleared buffer from the reserve; false if there is none that fits */
+static bool exynos_gem_pool_get(struct exynos_drm_gem *exynos_gem, unsigned long attrs)
+{
+	struct exynos_gem_pool_buf *buf, *found = NULL;
+
+	if (!exynos_gem_pool_eligible(exynos_gem->base.size, attrs))
+		return false;
+
+	spin_lock(&gem_pool.lock);
+	list_for_each_entry(buf, &gem_pool.clean, node) {
+		if (buf->size == exynos_gem->base.size && buf->attrs == attrs &&
+		    buf->dev == drm_dev_dma_dev(exynos_gem->base.dev)) {
+			found = buf;
+			list_del(&buf->node);
+			gem_pool.clean_pages -= buf->size >> PAGE_SHIFT;
+			gem_pool.nr--;
+			break;
+		}
+	}
+	if (found)
+		gem_pool_hits++;
+	else
+		gem_pool_misses++;
+	spin_unlock(&gem_pool.lock);
+
+	if (!found)
+		return false;
+
+	exynos_gem->cookie = found->cookie;
+	exynos_gem->dma_addr = found->dma_addr;
+	kfree(found);
+	return true;
+}
+
 static int exynos_drm_alloc_buf(struct exynos_drm_gem *exynos_gem, bool kvmap)
 {
 	struct drm_device *dev = exynos_gem->base.dev;
@@ -55,6 +347,9 @@ static int exynos_drm_alloc_buf(struct exynos_drm_gem *exynos_gem, bool kvmap)
 		attr |= DMA_ATTR_NO_KERNEL_MAPPING;
 
 	exynos_gem->dma_attrs = attr;
+	if (!kvmap && exynos_gem_pool_get(exynos_gem, attr))
+		return 0;
+
 	exynos_gem->cookie = dma_alloc_attrs(drm_dev_dma_dev(dev), exynos_gem->base.size,
 					     &exynos_gem->dma_addr, GFP_KERNEL,
 					     exynos_gem->dma_attrs);
@@ -83,6 +378,9 @@ static void exynos_drm_free_buf(struct exynos_drm_gem *exynos_gem)
 	DRM_DEV_DEBUG_KMS(dev->dev, "dma_addr(0x%pad), size(0x%zx)\n",
 			  &exynos_gem->dma_addr, exynos_gem->base.size);
 
+	if (exynos_gem_pool_put(exynos_gem))
+		return;
+
 	dma_free_attrs(drm_dev_dma_dev(dev), exynos_gem->base.size, exynos_gem->cookie,
 			(dma_addr_t)exynos_gem->dma_addr,
 			exynos_gem->dma_attrs);
-- 
