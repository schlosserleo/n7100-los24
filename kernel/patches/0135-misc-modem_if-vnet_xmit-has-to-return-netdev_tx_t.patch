From a2f181a329cbc3550212a7fb1ab71a893d85673d Mon Sep 17 00:00:00 2001
From: blue898 <201240079+blue898@users.noreply.github.com>
Date: Mon, 16 Nov 2026 20:49:27 +0100
Subject: [PATCH 135/146] misc: modem_if: vnet_xmit() has to return netdev_tx_t

vnet_xmit() is the rmnet devices' ndo_start_xmit but was declared as
returning int. The kernel is built with CFI and without
CONFIG_CFI_PERMISSIVE, so the first packet sent over mobile data ended
in

  CFI failure at dev_hard_start_xmit

and a panic. (The modem had not been used with a SIM before.) A build
with -Wincompatible-function-pointer-types-strict finds no other such
place in this configuration.

While here, in the same function:
- it returned NETDEV_TX_BUSY after freeing the skb, which makes the core
  queue the freed skb again; count it as dropped and return NETDEV_TX_OK
- it returned -ENOMEM, which is not a netdev_tx_t either
- tx_bytes was read from the skb after ld->send() had taken it, and from
  the original skb, which is already freed when it had to be copied

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 drivers/misc/modem_if/sipc4_io_device.c | 16 +++++++++++-----
 1 file changed, 11 insertions(+), 5 deletions(-)

diff --git a/drivers/misc/modem_if/sipc4_io_device.c b/drivers/misc/modem_if/sipc4_io_device.c
index 99418888c..82f8f0bce 100755
--- a/drivers/misc/modem_if/sipc4_io_device.c
+++ b/drivers/misc/modem_if/sipc4_io_device.c
@@ -1362,9 +1362,10 @@ static int vnet_stop(struct net_device *ndev)
 	return 0;
 }
 
-static int vnet_xmit(struct sk_buff *skb, struct net_device *ndev)
+static netdev_tx_t vnet_xmit(struct sk_buff *skb, struct net_device *ndev)
 {
 	int ret = 0;
+	unsigned int tx_len;
 	int headroom = 0;
 	int tailroom = 0;
 	struct sk_buff *skb_new = NULL;
@@ -1406,8 +1407,10 @@ static int vnet_xmit(struct sk_buff *skb, struct net_device *ndev)
 		skb_new = skb_copy_expand(skb, headroom, tailroom, GFP_ATOMIC);
 		/* skb_copy_expand success or not, free old skb from caller */
 		dev_kfree_skb_any(skb);
-		if (!skb_new)
-			return -ENOMEM;
+		if (!skb_new) {
+			ndev->stats.tx_dropped++;
+			return NETDEV_TX_OK;
+		}
 	} else
 		skb_new = skb;
 
@@ -1420,15 +1423,18 @@ static int vnet_xmit(struct sk_buff *skb, struct net_device *ndev)
 	skbpriv(skb_new)->iod = iod;
 	skbpriv(skb_new)->ld = ld;
 
+	tx_len = skb_new->len;
 	ret = ld->send(ld, iod, skb_new);
 	if (ret < 0) {
+		/* freed here, so it must not be reported as busy (requeued) */
 		netif_stop_queue(ndev);
 		dev_kfree_skb_any(skb_new);
-		return NETDEV_TX_BUSY;
+		ndev->stats.tx_dropped++;
+		return NETDEV_TX_OK;
 	}
 
 	ndev->stats.tx_packets++;
-	ndev->stats.tx_bytes += skb->len;
+	ndev->stats.tx_bytes += tx_len;
 
 	return NETDEV_TX_OK;
 }
-- 
